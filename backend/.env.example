# === LLM Provider ===
# Supported: gemini, openai
LLM_PROVIDER=gemini

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI (alternative)
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-4o

# === Application ===
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# === File Upload ===
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=.pdf,.docx,.doc,.txt

# === CORS ===
CORS_ORIGINS=http://localhost:3000

# === Logging ===
LOG_LEVEL=INFO
